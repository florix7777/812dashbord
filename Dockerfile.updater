# Dashboard SC - Data Updater (auto_updater.py)
# Watches ./reports for new XLSX/PDF files, parses them, and writes
# results into Postgres (API Mode) and assets/js/data.js (static fallback).
FROM python:3.12-slim

WORKDIR /app

COPY requirements-updater.txt .
RUN pip install --no-cache-dir -r requirements-updater.txt

COPY auto_updater.py .

# reports/ and assets/js/ are bind-mounted at runtime (see docker-compose.yml)
RUN mkdir -p /app/reports /app/assets/js

CMD ["python", "auto_updater.py"]
